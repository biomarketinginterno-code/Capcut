# --- Acceso al CRM -----------------------------------------------------------
# Contraseña para entrar al panel. Si la dejás vacía se genera una al iniciar
# (queda en data/admin-password.txt y se muestra en el log).
ADMIN_PASSWORD=

PORT=3000
# Carpeta donde se guarda la base de datos (en Render/Railway: montá un disco acá)
DATA_DIR=./data
# Poné 1 si lo publicás detrás de HTTPS (Render, Railway, Fly, etc.)
COOKIE_SECURE=0

# --- WhatsApp Cloud API (Meta) ----------------------------------------------
# Si TOKEN y PHONE_NUMBER_ID están vacíos el CRM funciona en MODO SIMULACIÓN
# (no envía nada real, sirve para probar). Guía paso a paso en el README.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Texto cualquiera que vos elegís; Meta lo usa para verificar el webhook
WHATSAPP_VERIFY_TOKEN=
# "Clave secreta" de la app de Meta. OBLIGATORIA para aceptar respuestas entrantes.
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v25.0
# Avanzado: si Meta rechaza números argentinos con el 9, poné 1 para enviar 54XXXXXXXXXX
WHATSAPP_AR_DROP_9=0

# --- Cola de envío -------------------------------------------------------------
# Mensajes máximos por ciclo (cada 5 s). 5 = ~60 por minuto.
SEND_BATCH=5
