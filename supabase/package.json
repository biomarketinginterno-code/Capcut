{
  "name": "crm-peques-supabase",
  "private": true,
  "type": "module",
  "description": "Backend del CRM en Supabase (Postgres + Edge Function). Los tests corren en Node con PGlite (Postgres en memoria).",
  "scripts": {
    "test": "node --test --disable-warning=ExperimentalWarning tests/*.test.ts",
    "test:pg": "TEST_DRIVER=postgres node --test --disable-warning=ExperimentalWarning tests/*.test.ts",
    "dev": "node --disable-warning=ExperimentalWarning dev-server.ts"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.15",
    "@electric-sql/pglite-socket": "0.0.20",
    "postgres": "3.4.5"
  },
  "engines": {
    "node": ">=22.18"
  }
}
